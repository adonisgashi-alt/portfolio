---
/**
 * An image that mounts as a dithered canvas plate. Falls back to a filtered
 * <img> with no JS.
 */
interface Props {
  src: string;
  alt: string;
  stops?: string;
  /** CSS pixels per dither cell — bigger is chunkier and cheaper. */
  cell?: number;
  /** Radius of the cursor reveal, in CSS pixels. */
  focus?: number;
  /** How far the plate resolves toward the source on hover, 0–1. */
  reveal?: number;
  ratio?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  alt,
  stops = '#050508,#6c5cff,#ecebe4',
  cell = 4,
  focus = 130,
  reveal = 0.4,
  ratio = '4 / 3',
  class: className,
  loading = 'lazy',
} = Astro.props;
---

<figure
  class:list={['plate', className]}
  data-dither
  data-dither-stops={stops}
  data-dither-cell={String(cell)}
  data-dither-focus={String(focus)}
  data-dither-reveal={String(reveal)}
  style={`--plate-ratio:${ratio}`}
>
  <img src={src} alt={alt} loading={loading} decoding="async" />
</figure>

<style>
  .plate {
    border: 1px solid var(--color-border);
  }
</style>
