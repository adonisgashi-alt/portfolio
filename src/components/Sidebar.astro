---
import { getCollection } from 'astro:content';
import { site, nav } from '../data/site';

const counts = {
  work: (await getCollection('work', ({ data }) => !data.draft)).length,
  articles: (await getCollection('articles', ({ data }) => !data.draft)).length,
};

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const pad = (n: number) => String(n).padStart(2, '0');
---

<header class="sidebar">
  <div class="sidebar-inner">
    <a class="brand" href="/" aria-label={`${site.name} — home`}>
      <span class="mark" aria-hidden="true">{site.initials}</span>
      <span class="brand-text">
        <span class="brand-name">{site.name}</span>
        <span class="brand-role">{site.role}</span>
      </span>
    </a>

    <details class="menu">
      <summary aria-label="Menu">
        <span class="menu-icon" aria-hidden="true"></span>
      </summary>
      <div class="menu-panel">
        <nav aria-label="Primary">
          <p class="nav-label">Index</p>
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={['nav-link', { active: isActive(item.href) }]}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                  >
                    <span>{item.label}</span>
                    {item.collection && <span class="count">{pad(counts[item.collection])}</span>}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="sidebar-foot">
          {
            site.availability.open && (
              <p class="status">
                <span class="dot" aria-hidden="true" />
                {site.availability.label}
              </p>
            )
          }
          <a class="btn btn-primary contact-btn" href={`mailto:${site.email}`}>Get in touch</a>
          <ul class="socials">
            {
              site.socials.map((s) => (
                <li>
                  <a href={s.href} rel="me noopener" target="_blank">
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  // On desktop the menu is always visible; keep <details> open there so its
  // contents are rendered, and let it collapse on small screens.
  const menu = document.querySelector<HTMLDetailsElement>('.sidebar .menu');
  const mq = window.matchMedia('(min-width: 960px)');
  const sync = () => {
    if (menu) menu.open = mq.matches;
  };
  sync();
  mq.addEventListener('change', sync);
</script>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .brand-name {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
  }

  .brand-role {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Mobile menu toggle */
  .menu summary {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-icon,
  .menu-icon::before {
    display: block;
    width: 14px;
    height: 1.5px;
    background: var(--color-text);
    transition: transform 0.2s var(--ease);
  }

  .menu-icon {
    position: relative;
    transform: translateY(-3px);
  }

  .menu-icon::before {
    content: '';
    position: absolute;
    top: 6px;
  }

  .menu[open] .menu-icon {
    transform: translateY(0) rotate(45deg);
  }

  .menu[open] .menu-icon::before {
    top: 0;
    transform: rotate(-90deg);
  }

  .menu-panel {
    position: absolute;
    inset: 100% 0 auto 0;
    padding: var(--space-4) var(--gutter) var(--space-6);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 24px 40px -24px rgb(15 18 23 / 0.18);
  }

  .nav-label {
    padding: 0 var(--space-3) var(--space-2);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-subtle);
    letter-spacing: var(--tracking-label);
  }

  nav ul,
  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 2.25rem;
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    transition:
      background-color 0.15s var(--ease),
      color 0.15s var(--ease);
  }

  .nav-link:hover {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .nav-link.active {
    background: var(--color-primary-soft);
    color: var(--color-text);
  }

  .count {
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-subtle);
  }

  .sidebar-foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding: 0 var(--space-3);
  }

  .status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #5fb58a;
    box-shadow: 0 0 0 3px color-mix(in srgb, #5fb58a 22%, transparent);
  }

  .contact-btn {
    justify-content: center;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .socials a:hover {
    color: var(--color-text);
  }

  /* Desktop: fixed left rail */
  @media (min-width: 960px) {
    .sidebar {
      height: 100dvh;
      border-bottom: 0;
      border-right: 1px solid var(--color-border);
      background: var(--color-bg);
      backdrop-filter: none;
    }

    .sidebar-inner {
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: var(--space-7);
      height: 100%;
      padding: var(--space-5) var(--space-4);
    }

    .brand {
      padding: 0 var(--space-3);
    }

    .menu {
      flex: 1;
      display: flex;
    }

    .menu summary {
      display: none;
    }

    .menu-panel {
      position: static;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      flex: 1;
      padding: 0;
      border: 0;
      box-shadow: none;
      background: none;
    }
  }
</style>
