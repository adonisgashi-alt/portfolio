---
// Project cover. Renders `src` when given; otherwise a quiet generated
// placeholder tinted with `tint`, so layouts look finished before real
// imagery exists.
interface Props {
  title: string;
  src?: string;
  tint?: string;
  variant?: number;
  eager?: boolean;
}

const { title, src, tint = '#a9c8e6', variant = 0, eager = false } = Astro.props;
const v = Math.abs(variant) % 4;
---

<div class="cover" style={`--tint: ${tint}`}>
  {
    src ? (
      <img src={src} alt={`${title} — cover`} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <svg viewBox="0 0 800 500" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`${title} — placeholder cover`}>
        {v === 0 && (
          <g>
            <rect x="120" y="90" width="560" height="340" rx="20" class="card" />
            <rect x="150" y="125" width="180" height="16" rx="8" class="ink" />
            <rect x="150" y="160" width="300" height="10" rx="5" class="line" />
            <rect x="150" y="180" width="260" height="10" rx="5" class="line" />
            <rect x="150" y="230" width="230" height="170" rx="14" class="tint" />
            <rect x="400" y="230" width="250" height="80" rx="14" class="soft" />
            <rect x="400" y="320" width="250" height="80" rx="14" class="soft" />
          </g>
        )}
        {v === 1 && (
          <g>
            <circle cx="400" cy="250" r="150" class="tint" />
            <circle cx="400" cy="250" r="96" class="card" />
            <rect x="330" y="230" width="140" height="40" rx="20" class="ink" />
          </g>
        )}
        {v === 2 && (
          <g>
            <rect x="140" y="110" width="150" height="150" rx="16" class="card" />
            <rect x="325" y="110" width="150" height="150" rx="75" class="tint" />
            <rect x="510" y="110" width="150" height="150" rx="16" class="soft" />
            <rect x="140" y="295" width="335" height="95" rx="16" class="soft" />
            <rect x="510" y="295" width="150" height="95" rx="16" class="ink" />
          </g>
        )}
        {v === 3 && (
          <g>
            <rect x="290" y="60" width="220" height="440" rx="36" class="card" />
            <rect x="315" y="110" width="170" height="120" rx="16" class="tint" />
            <rect x="315" y="250" width="120" height="12" rx="6" class="ink" />
            <rect x="315" y="275" width="170" height="10" rx="5" class="line" />
            <rect x="315" y="295" width="150" height="10" rx="5" class="line" />
            <rect x="315" y="330" width="170" height="56" rx="14" class="soft" />
          </g>
        )}
      </svg>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--tint) 28%, var(--color-surface));
  }

  .cover img,
  .cover svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .card {
    fill: var(--color-bg);
  }
  .tint {
    fill: var(--tint);
  }
  .soft {
    fill: color-mix(in srgb, var(--tint) 35%, var(--color-bg));
  }
  .ink {
    fill: var(--color-text);
    opacity: 0.85;
  }
  .line {
    fill: var(--color-border-strong);
  }
</style>
