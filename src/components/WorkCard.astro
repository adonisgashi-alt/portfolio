---
import Placeholder from './Placeholder.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  /** Large cards run full width with the copy beside the image. */
  size?: 'default' | 'large';
  ratio?: string;
}

const { entry, size = 'default', ratio } = Astro.props;
const { title, client, year, summary, cover, disciplines } = entry.data;
const href = `/work/${entry.id}`;
---

<article class:list={['work-card', `work-card--${size}`]}>
  <a class="work-card__link" href={href}>
    <span class="visually-hidden">View case study: {title}</span>
  </a>

  <div class="work-card__media">
    <Placeholder
      label={cover.label}
      ratio={ratio ?? (size === 'large' ? '16 / 9' : '4 / 3')}
      tone={cover.tone}
    />
  </div>

  <div class="work-card__body">
    <p class="caption">{client} {year}</p>
    <h3 class="work-card__title">{title}</h3>
    <p class="work-card__summary">{summary}</p>
    <p class="link-chevron link-chevron--small work-card__cta" aria-hidden="true">
      View case study
    </p>
    {
      disciplines.length > 0 && (
        <ul class="work-card__tags" aria-label="Disciplines">
          {disciplines.map((d) => <li class="work-card__tag">{d}</li>)}
        </ul>
      )
    }
  </div>
</article>

<style>
  .work-card {
    position: relative;
    display: grid;
    gap: var(--space-200);
  }

  .work-card__link {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: var(--radius-lg);
  }

  .work-card__media {
    overflow: hidden;
  }

  .work-card__media :global(.ph) {
    transition: transform 0.6s var(--ease);
  }

  .work-card:hover .work-card__media :global(.ph) {
    transform: scale(1.02);
  }

  /* Card copy mirrors the reference's product cards: 16px medium title,
     muted description, then a small arrow link. */
  .work-card__title {
    font-size: var(--text-body);
    line-height: 1.35;
    letter-spacing: var(--tracking-body);
    font-weight: 500;
    margin-top: var(--space-050);
  }

  .work-card__summary {
    color: var(--color-muted);
    margin-top: var(--space-050);
    max-width: 52ch;
  }

  .work-card__cta {
    margin-top: var(--space-150);
  }

  .work-card:hover .work-card__cta {
    color: var(--color-primary-ink);
  }

  .work-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-100);
    margin-top: var(--space-150);
    padding: 0;
    list-style: none;
  }

  .work-card__tag {
    padding: var(--space-050) var(--space-100);
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    color: var(--color-muted);
    font-size: var(--text-fine);
    line-height: 1.4;
  }

  /* The lead card is the feature moment — full-width image, then a larger
     display-cut title underneath, like the reference's featured article. */
  .work-card--large .work-card__title {
    font-size: var(--text-title);
    line-height: 1.22;
    letter-spacing: var(--tracking-title);
    max-width: 24ch;
  }

  .work-card--large .work-card__summary {
    margin-top: var(--space-150);
    font-size: var(--text-body-lg);
    letter-spacing: var(--tracking-body-lg);
  }
</style>
