---
/**
 * Stand-in for artwork that hasn't been shot or exported yet.
 * Renders a neutral panel at a fixed aspect ratio so every page already has
 * its final composition — drop a real <img> in place of it later.
 */
interface Props {
  label?: string;
  ratio?: string;
  tone?: 'light' | 'mid' | 'dark';
  radius?: 'none' | 'md' | 'lg';
  caption?: string;
  class?: string;
}

const {
  label = 'Image',
  ratio = '16 / 9',
  tone = 'light',
  radius = 'lg',
  caption,
  class: className,
} = Astro.props;
---

<figure class:list={['ph-figure', className]}>
  <div
    class:list={['ph', `ph--${tone}`, `ph--radius-${radius}`]}
    style={`--ph-ratio: ${ratio};`}
    role="img"
    aria-label={`Placeholder for ${label}`}
  >
    <div class="ph__grid" aria-hidden="true"></div>
    <div class="ph__mark" aria-hidden="true">
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.25">
        <rect x="6.5" y="10.5" width="35" height="27" rx="3.5"></rect>
        <circle cx="17" cy="20" r="3"></circle>
        <path d="M8 33.5 19 24l7.5 6.5L33 25l8 7"></path>
      </svg>
      <span class="ph__label">{label}</span>
    </div>
  </div>
  {caption && <figcaption class="caption ph__caption">{caption}</figcaption>}
</figure>

<style>
  .ph-figure {
    margin: 0;
  }

  .ph {
    position: relative;
    aspect-ratio: var(--ph-ratio);
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .ph--radius-lg {
    border-radius: var(--radius-lg);
  }

  .ph--radius-md {
    border-radius: var(--radius);
  }

  .ph--radius-none {
    border-radius: 0;
  }

  .ph--light {
    background: linear-gradient(150deg, #fafafa 0%, #f0f0f2 48%, #e3e3e6 100%);
    color: #a1a1a6;
  }

  .ph--mid {
    background: linear-gradient(150deg, #e9e9ec 0%, #dcdce0 50%, #c9c9ce 100%);
    color: #7a7a80;
  }

  .ph--dark {
    background: linear-gradient(150deg, #2a2a2c 0%, #1b1b1d 50%, #0a0a0b 100%);
    color: #6e6e73;
  }

  /* Faint construction grid — reads as "artwork goes here", not as decoration. */
  .ph__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(currentColor 1px, transparent 1px),
      linear-gradient(90deg, currentColor 1px, transparent 1px);
    background-size: 12.5% 12.5%;
    opacity: 0.11;
  }

  .ph__mark {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.5rem;
    text-align: center;
  }

  .ph__mark svg {
    width: 2.5rem;
    height: 2.5rem;
    opacity: 0.75;
  }

  .ph__label {
    font-size: var(--text-fine);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    max-width: 22ch;
  }

  .ph__caption {
    margin-top: 0.875rem;
  }

  @media (prefers-color-scheme: dark) {
    .ph--light {
      background: linear-gradient(150deg, #232325 0%, #19191b 48%, #0d0d0e 100%);
      color: #6e6e73;
    }

    .ph--mid {
      background: linear-gradient(150deg, #2e2e31 0%, #232326 50%, #151517 100%);
      color: #86868b;
    }
  }
</style>
