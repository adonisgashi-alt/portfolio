---
/**
 * Stand-in for artwork that hasn't been shot or exported yet.
 * Renders a neutral panel at a fixed aspect ratio so every page already has
 * its final composition — drop a real <img> in place of it later.
 */
interface Props {
  label?: string;
  ratio?: string;
  tone?: 'light' | 'mid' | 'dark';
  radius?: 'none' | 'md' | 'lg';
  caption?: string;
  class?: string;
}

const {
  label = 'Image',
  ratio = '16 / 9',
  tone = 'light',
  radius = 'none',
  caption,
  class: className,
} = Astro.props;
---

<figure class:list={['ph-figure', className]}>
  <div
    class:list={['ph', `ph--${tone}`, `ph--radius-${radius}`]}
    style={`--ph-ratio: ${ratio};`}
    role="img"
    aria-label={`Placeholder for ${label}`}
  >
    <div class="ph__grid" aria-hidden="true"></div>
    <div class="ph__mark" aria-hidden="true">
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.25">
        <rect x="6.5" y="10.5" width="35" height="27" rx="3.5"></rect>
        <circle cx="17" cy="20" r="3"></circle>
        <path d="M8 33.5 19 24l7.5 6.5L33 25l8 7"></path>
      </svg>
      <span class="ph__label">{label}</span>
    </div>
  </div>
  {caption && <figcaption class="caption ph__caption">{caption}</figcaption>}
</figure>

<style>
  .ph-figure {
    margin: 0;
  }

  .ph {
    position: relative;
    aspect-ratio: var(--ph-ratio);
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .ph--radius-lg {
    border-radius: var(--radius-lg);
  }

  .ph--radius-md {
    border-radius: var(--radius);
  }

  .ph--radius-none {
    border-radius: 0;
  }

  /* Pale grey tile — the reference's default image surface. */
  .ph--light {
    background: #f5f5f5;
    color: #a3a3a3;
  }

  /* Soft sky gradient in the primary blue — echoes the reference's
     atmospheric hero imagery. */
  .ph--mid {
    background: radial-gradient(120% 90% at 20% 10%, #f4f8fc 0%, transparent 60%),
      linear-gradient(160deg, #e6eff8 0%, #cfe0f1 55%, #b7d0ea 100%);
    color: #5d7f9f;
  }

  .ph--dark {
    background: linear-gradient(160deg, #1f1f22 0%, #141416 50%, #0a0a0a 100%);
    color: #6e6e73;
  }

  /* Faint construction grid — reads as "artwork goes here", not as decoration. */
  .ph__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(currentColor 1px, transparent 1px),
      linear-gradient(90deg, currentColor 1px, transparent 1px);
    background-size: 12.5% 12.5%;
    opacity: 0.08;
  }

  .ph__mark {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-24);
    text-align: center;
  }

  .ph__mark svg {
    width: 2.5rem;
    height: 2.5rem;
    opacity: 0.75;
  }

  .ph__label {
    font-family: var(--font-mono);
    font-size: var(--text-fine);
    letter-spacing: 0;
    text-transform: uppercase;
    max-width: 26ch;
  }

  .ph__caption {
    margin-top: var(--space-16);
  }

  :global(:root[data-theme='dark']) .ph--light {
    background: #141416;
    color: #6e6e73;
  }

  :global(:root[data-theme='dark']) .ph--mid {
    background: linear-gradient(160deg, #1b2530 0%, #16202a 55%, #121a22 100%);
    color: #7f9bb6;
  }
</style>
