---
/**
 * Stand-in for artwork that hasn't been shot or exported yet.
 * Renders a neutral panel at a fixed aspect ratio so every page already has
 * its final composition — drop a real <img> in place of it later.
 */
interface Props {
  label?: string;
  ratio?: string;
  tone?: 'light' | 'mid' | 'dark';
  radius?: 'none' | 'md' | 'lg';
  caption?: string;
  class?: string;
}

const {
  label = 'Image',
  ratio = '16 / 9',
  tone = 'light',
  radius = 'lg',
  caption,
  class: className,
} = Astro.props;
---

<figure class:list={['ph-figure', className]}>
  <div
    class:list={['ph', `ph--${tone}`, `ph--radius-${radius}`]}
    style={`--ph-ratio: ${ratio};`}
    role="img"
    aria-label={`Placeholder for ${label}`}
  >
    <div class="ph__grid" aria-hidden="true"></div>
    <div class="ph__mark" aria-hidden="true">
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.25">
        <rect x="6.5" y="10.5" width="35" height="27" rx="3.5"></rect>
        <circle cx="17" cy="20" r="3"></circle>
        <path d="M8 33.5 19 24l7.5 6.5L33 25l8 7"></path>
      </svg>
      <span class="ph__label">{label}</span>
    </div>
  </div>
  {caption && <figcaption class="caption ph__caption">{caption}</figcaption>}
</figure>

<style>
  .ph-figure {
    margin: 0;
  }

  .ph {
    position: relative;
    aspect-ratio: var(--ph-ratio);
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .ph--radius-lg {
    border-radius: var(--radius-lg);
  }

  .ph--radius-md {
    border-radius: var(--radius);
  }

  .ph--radius-none {
    border-radius: 0;
  }

  .ph--light {
    background: linear-gradient(150deg, #fbfaf7 0%, #f2f0ea 48%, #e7e4db 100%);
    color: #a8a29a;
  }

  .ph--mid {
    background: linear-gradient(150deg, #edebe4 0%, #e2dfd6 50%, #d2cec3 100%);
    color: #7d786f;
  }

  .ph--dark {
    background: linear-gradient(150deg, #2b2924 0%, #1c1a17 50%, #100f0d 100%);
    color: #6f6a62;
  }

  /* Faint construction grid — reads as "artwork goes here", not as decoration. */
  .ph__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(currentColor 1px, transparent 1px),
      linear-gradient(90deg, currentColor 1px, transparent 1px);
    background-size: 12.5% 12.5%;
    opacity: 0.11;
  }

  .ph__mark {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.5rem;
    text-align: center;
  }

  .ph__mark svg {
    width: 2.5rem;
    height: 2.5rem;
    opacity: 0.75;
  }

  .ph__label {
    font-size: var(--text-fine);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    max-width: 22ch;
  }

  .ph__caption {
    margin-top: 0.875rem;
  }

  @media (prefers-color-scheme: dark) {
    .ph--light {
      background: linear-gradient(150deg, #24221e 0%, #1a1917 48%, #0e0d0c 100%);
      color: #6f6a62;
    }

    .ph--mid {
      background: linear-gradient(150deg, #2f2c27 0%, #242220 50%, #161514 100%);
      color: #8a857b;
    }
  }
</style>
