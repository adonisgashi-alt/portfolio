---
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container container--wide">
    <p class="fine footer__note">
      All project imagery on this site is placeholder artwork. Case study
      details are representative of process and are shared with client
      permission where applicable.
    </p>

    <hr class="rule" />

    <div class="footer__columns">
      <div class="footer__col">
        <h2 class="footer__heading">Site</h2>
        <ul class="footer__list">
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__heading">Work</h2>
        <ul class="footer__list">
          <li><a href="/work">Selected projects</a></li>
          <li><a href="/about">Experience</a></li>
          <li><a href="/contact">Availability</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__heading">Elsewhere</h2>
        <ul class="footer__list">
          <li>
            <a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
          </li>
          <li><a href={`mailto:${site.email}`}>Email</a></li>
        </ul>
      </div>
    </div>

    <hr class="rule" />

    <div class="footer__base">
      <p class="fine">Copyright &copy; {year} {site.name}. All rights reserved.</p>
      <p class="fine footer__meta">{site.location} &nbsp;|&nbsp; {site.role} at {site.company}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface);
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .footer__note {
    max-width: 62ch;
    margin-bottom: 1.25rem;
  }

  .footer__columns {
    display: grid;
    gap: 1.75rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    padding-block: 1.75rem;
  }

  .footer__heading {
    font-size: var(--text-fine);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 0.625rem;
    color: var(--color-ink);
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .footer__list a {
    font-size: var(--text-fine);
    color: var(--color-muted);
    text-decoration: none;
  }

  .footer__list a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.25rem;
  }

  .footer__meta {
    color: var(--color-muted-2);
  }
</style>
