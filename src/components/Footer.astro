---
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__intro">
        <span class="footer__mark" aria-hidden="true">AG</span>
        <p class="footer__tagline">
          {site.role} at {site.company}, working across brand, digital, web, events and campaigns.
        </p>
        <p class="footer__quick">
          <a href="/contact">Get in touch</a>
          <a href="/work">See the work</a>
        </p>
      </div>

      <div class="footer__columns">
        <div class="footer__col">
          <h2 class="footer__heading">Site</h2>
          <ul class="footer__list">
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>

        <div class="footer__col">
          <h2 class="footer__heading">Work</h2>
          <ul class="footer__list">
            <li><a href="/work">Selected projects</a></li>
            <li><a href="/about">Experience</a></li>
            <li><a href="/contact">Availability</a></li>
          </ul>
        </div>

        <div class="footer__col">
          <h2 class="footer__heading">Elsewhere</h2>
          <ul class="footer__list">
            <li>
              <a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
            </li>
            <li><a href={`mailto:${site.email}`}>Email</a></li>
          </ul>
        </div>
      </div>
    </div>

    <hr class="rule" />

    <p class="fine footer__note">
      All project imagery on this site is placeholder artwork. Case study
      details are representative of process and are shared with client
      permission where applicable.
    </p>

    <hr class="rule" />

    <div class="footer__base">
      <p class="fine">&copy; {year} {site.name} &middot; {site.location}</p>
      <p class="fine">{site.role} at {site.company}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
  }

  .footer__top {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
  }

  .footer__mark {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 7px;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .footer__tagline {
    margin-top: 1.25rem;
    max-width: 26ch;
    font-size: var(--text-subhead);
    line-height: 1.4;
    letter-spacing: var(--tracking-subhead);
  }

  .footer__quick {
    display: grid;
    gap: 0.25rem;
    margin-top: 1rem;
    font-size: var(--text-subhead);
    letter-spacing: var(--tracking-subhead);
  }

  .footer__quick a,
  .footer__list a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .footer__quick a:hover,
  .footer__list a:hover {
    color: var(--color-ink);
  }

  .footer__columns {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .footer__heading {
    font-size: var(--text-body);
    font-weight: 500;
    margin-bottom: 0.75rem;
    color: var(--color-ink);
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.375rem;
    font-size: var(--text-small);
    letter-spacing: 0;
  }

  .footer__note {
    max-width: 70ch;
    padding-block: 1.25rem;
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.25rem;
  }

  @media (min-width: 900px) {
    .footer__top {
      grid-template-columns: 1fr 1.1fr;
    }
  }
</style>
