---
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const [lead, ...rest] = featured;

const principles = [
  {
    title: 'Hierarchy first',
    body: 'Decide what matters most on the page before deciding what it looks like. Everything else gets quieter.',
  },
  {
    title: 'One system, not five',
    body: 'Type, color and spacing settled once, then applied everywhere — so the work looks related without being repetitive.',
  },
  {
    title: 'Imagery that carries weight',
    body: 'Photography is a load-bearing part of the layout, not a decoration dropped in at the end.',
  },
];
---

<Layout title={`${site.name} — ${site.role}`}>
  <!-- Hero -->
  <section class="section section--flush-bottom hero">
    <div class="container center">
      <p class="eyebrow" data-reveal>{site.role} at {site.company}</p>
      <h1 class="display hero__headline" data-reveal style="--reveal-delay: 60ms">
        Design that gets<br />out of the way.
      </h1>
      <p class="subhead measure--wide hero__sub" data-reveal style="--reveal-delay: 120ms">
        I'm {site.name.split(' ')[0]} — a visual designer working across brand,
        product and campaign. I build systems that make the right choice the
        easy one.
      </p>
      <div class="link-row hero__links" data-reveal style="--reveal-delay: 180ms">
        <a class="link-chevron" href="/work">See the work</a>
        <a class="link-chevron" href="/about">About me</a>
      </div>
    </div>

    <div class="container container--full hero__media" data-reveal style="--reveal-delay: 240ms">
      <Placeholder
        label="Hero image — signature piece of recent work"
        ratio="21 / 9"
        tone="mid"
      />
    </div>
  </section>

  <!-- Featured work -->
  <section class="section">
    <div class="container container--wide">
      <header class="section-head" data-reveal>
        <h2 class="headline">Selected work.</h2>
        <p class="subhead measure--wide">
          Six projects, each one a system that outlived the deadline.
        </p>
      </header>

      {lead && (
        <div class="featured-lead" data-reveal>
          <WorkCard entry={lead} size="large" />
        </div>
      )}

      {rest.length > 0 && (
        <div class="grid grid--2 featured-grid" style="--grid-gap: clamp(2rem, 4vw, 3.5rem)">
          {rest.map((entry, i) => (
            <div data-reveal style={`--reveal-delay: ${i * 80}ms`}>
              <WorkCard entry={entry} />
            </div>
          ))}
        </div>
      )}

      <p class="featured-more" data-reveal>
        <a class="link-chevron" href="/work">See all work</a>
      </p>
    </div>
  </section>

  <!-- Approach, on black -->
  <section class="section section--dark">
    <div class="container container--wide">
      <header class="section-head" data-reveal>
        <p class="eyebrow--caps">Approach</p>
        <h2 class="headline">Three things I hold to.</h2>
      </header>

      <div class="grid grid--3" style="--grid-gap: clamp(2rem, 4vw, 3rem)">
        {
          principles.map((item, i) => (
            <div class="principle" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
              <span class="principle__index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="title principle__title">{item.title}</h3>
              <p class="muted">{item.body}</p>
            </div>
          ))
        }
      </div>

      <div class="approach-media" data-reveal>
        <Placeholder
          label="Process image — sketches, boards and specimen sheets"
          ratio="21 / 9"
          tone="dark"
        />
      </div>
    </div>
  </section>

  <!-- Now -->
  <section class="section section--surface">
    <div class="container container--wide now">
      <div class="now__copy" data-reveal>
        <p class="eyebrow--caps">Currently</p>
        <h2 class="headline">At Commerce, on the brand system.</h2>
        <p class="body-lg muted now__body">
          Day to day I work on the visual language behind a large financial
          brand — identity, product surfaces, campaign art direction and the
          documentation that keeps it all speaking the same way.
        </p>
        <p class="now__link">
          <a class="link-chevron" href="/about">More about me</a>
        </p>
      </div>
      <div class="now__media" data-reveal style="--reveal-delay: 80ms">
        <Placeholder label="Workspace or portrait image" ratio="4 / 5" tone="light" />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta center">
    <div class="container">
      <h2 class="headline" data-reveal>Got something to make?</h2>
      <p class="subhead measure--wide cta__sub" data-reveal style="--reveal-delay: 60ms">
        I'm open to freelance and collaboration, and always happy to talk
        shop.
      </p>
      <div class="cta__actions" data-reveal style="--reveal-delay: 120ms">
        <a class="button button--primary" href="/contact">Get in touch</a>
        <a class="button button--secondary" href={site.linkedin} rel="me noopener" target="_blank">
          Connect on LinkedIn
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .hero__headline {
    margin-top: 0.75rem;
    text-wrap: balance;
  }

  .hero__sub {
    margin-top: 1.25rem;
  }

  .hero__links {
    margin-top: 1.75rem;
  }

  .hero__media {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .section-head {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .section-head .subhead {
    margin-top: 0.875rem;
  }

  .section-head .eyebrow--caps {
    margin-bottom: 0.875rem;
  }

  .featured-lead {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .featured-more {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .principle {
    border-top: 1px solid var(--color-line);
    padding-top: 1.25rem;
  }

  .principle__index {
    font-size: var(--text-fine);
    letter-spacing: 0.14em;
    color: var(--color-muted-2);
  }

  .principle__title {
    margin: 0.5rem 0 0.75rem;
  }

  .approach-media {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .now {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .now__body {
    margin-top: 1.25rem;
    max-width: 46ch;
  }

  .now__link {
    margin-top: 1.5rem;
  }

  .now .eyebrow--caps {
    margin-bottom: 0.875rem;
  }

  .cta__sub {
    margin-top: 1rem;
  }

  .cta__actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  @media (min-width: 900px) {
    .now {
      grid-template-columns: 1fr 0.8fr;
    }
  }
</style>
