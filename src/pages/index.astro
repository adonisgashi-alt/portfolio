---
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import WorkCard from '../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import commerceLogo from '../assets/logos/commerce.svg?raw';
import bigcommerceLogo from '../assets/logos/bigcommerce.svg?raw';
import feedonomicsLogo from '../assets/logos/feedonomics.svg?raw';
import schwabLogo from '../assets/logos/charles-schwab.svg?raw';
import pecbLogo from '../assets/logos/pecb.svg?raw';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const [lead, ...rest] = featured;

/* Every figure here is derived, not claimed: 2014 is the first role on the
   CV, 2021 the start at BigCommerce, and the case study count is the
   collection itself. Nothing to keep in sync by hand. */
const year = new Date().getFullYear();
const stats = [
  { label: 'Years designing', value: year - 2014 },
  { label: 'Years at Commerce & BigCommerce', value: year - 2021 },
  { label: 'Selected case studies', value: projects.length },
];

const principles = [
  {
    title: 'Hierarchy first',
    body: 'Decide what matters most before deciding what it looks like. Everything else gets quieter.',
  },
  {
    title: 'One system, not five',
    body: 'Type, color and layout settled once, then applied across web, campaign and event work — so a brand holds together in rooms nobody was designing for.',
  },
  {
    title: 'Built with the people building it',
    body: 'Brand, UX, Web, Product and Engineering all touch the same surfaces. Design that survives handoff is designed with them, not sent to them.',
  },
];

/* Where I've worked, newest first. Originals (brand colours) live in
   src/assets/logos; here every fill becomes currentColor so the row reads as
   one quiet, monochrome set that works in light and dark themes. */
const logoSources = [
  { name: 'Commerce', svg: commerceLogo },
  { name: 'BigCommerce', svg: bigcommerceLogo },
  { name: 'Feedonomics', svg: feedonomicsLogo },
  { name: 'Charles Schwab', svg: schwabLogo },
  // Solid, heavy letterforms read larger than their area, so trim it.
  { name: 'PECB', svg: pecbLogo, scale: 0.85 },
];

/* Optical sizing: give every logo roughly the same visual area rather than
   the same height, so a long wordmark (Schwab, ~7:1) doesn't dwarf a compact
   one (PECB, ~3.5:1). Height = sqrt(area / aspect ratio), in em. */
const LOGO_AREA = 11; // em² — PECB lands at ~28px tall, Schwab ~20px
const workplaces = logoSources.map(({ name, svg, scale = 1 }: { name: string; svg: string; scale?: number }) => {
  const [, , w, h] = svg.match(/viewBox="([^"]+)"/)![1].split(/\s+/).map(Number);
  const height = Math.sqrt(LOGO_AREA / (w / h)) * scale;
  const markup = svg
    .replace(/\s(width|height)="[^"]*"/g, '')
    .replace(/fill="(?!none)[^"]*"/g, 'fill="currentColor"')
    .replace('<svg', `<svg role="img" aria-label="${name}" focusable="false" style="height:${height.toFixed(3)}em"`);
  return { name, markup };
});
---

<Layout title={`${site.name} — ${site.role}`}>
  <!-- Hero -->
  <section class="section section--flush-bottom hero">
    <div class="container">
      <a class="pill hero__pill" href="/contact" data-reveal>
        <span class="pill__dot" aria-hidden="true"></span>
        Open to freelance and collaboration
      </a>
      <h1 class="display hero__headline" data-reveal style="--reveal-delay: 60ms">
        Design that gets<br />out of the way.
      </h1>

      <div class="hero__row" data-reveal style="--reveal-delay: 120ms">
        <div class="hero__actions">
          <a class="button button--primary" href="/work">See the work</a>
          <a class="button button--secondary" href="/contact">Get in touch</a>
        </div>
        <p class="hero__sub muted">
          I'm {site.name.split(' ')[0]} — a visual designer in Austin working
          across brand, web, campaigns and events. I build systems that make the
          right choice the easy one.
        </p>
      </div>

      <div class="hero__worked" data-reveal style="--reveal-delay: 180ms">
        <p class="eyebrow--caps">Where I've worked</p>
        <ul class="wordmarks">
          {workplaces.map((w) => <li class="wordmarks__item" set:html={w.markup} />)}
        </ul>
      </div>

      <div class="hero__media" data-reveal style="--reveal-delay: 240ms">
        <Placeholder
          label="Hero image — signature piece of recent work"
          ratio="2 / 1"
          tone="mid"
        />
      </div>
    </div>
  </section>

  <!-- Featured work -->
  <section class="section">
    <div class="container">
      <header class="section-head" data-reveal>
        <h2 class="headline">Selected work for {site.company} and the brands under it</h2>
        <p class="muted section-head__sub">
          Brand, campaign, event and product marketing work — from early
          exploration to what shipped.
        </p>
      </header>

      {lead && (
        <div class="featured-lead" data-reveal>
          <WorkCard entry={lead} size="large" ratio="2 / 1" />
        </div>
      )}

      {rest.length > 0 && (
        <div class="grid grid--2 featured-grid" style="--grid-gap: clamp(2.5rem, 4vw, 3rem) 1rem">
          {rest.map((entry, i) => (
            <div data-reveal style={`--reveal-delay: ${i * 80}ms`}>
              <WorkCard entry={entry} />
            </div>
          ))}
        </div>
      )}

      <p class="featured-more" data-reveal>
        <a class="button button--ghost featured-more__button" href="/work">See all work</a>
      </p>
    </div>
  </section>

  <!-- Stats -->
  <section class="section section--flush-top">
    <div class="container">
      <p class="eyebrow--caps stats__label" data-reveal>By the numbers</p>
      <div class="stat-list">
        {
          stats.map((stat, i) => (
            <div class="stat-row" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
              <span class="stat-row__label">{stat.label}</span>
              <span class="stat-row__value">{stat.value}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section section--flush-top">
    <div class="container">
      <header class="section-head" data-reveal>
        <h2 class="headline">Three things I hold to when the brief gets complicated</h2>
      </header>

      <div class="grid grid--3" style="--grid-gap: 2rem 1rem">
        {
          principles.map((item, i) => (
            <div class="quote-card" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
              <div>
                <p class="principle__markers" aria-hidden="true">
                  <span class="marker" />
                </p>
                <p class="quote-card__text">{item.title}</p>
                <p class="muted principle__body">{item.body}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="approach-media" data-reveal>
        <Placeholder
          label="Process image — sketches, boards and specimen sheets"
          ratio="2 / 1"
          tone="light"
        />
      </div>
    </div>
  </section>

  <!-- Now -->
  <section class="section section--flush-top">
    <div class="container now">
      <div class="now__copy" data-reveal>
        <p class="eyebrow--caps">Currently</p>
        <h2 class="headline now__title">Senior Designer at Commerce</h2>
        <p class="body-lg muted now__body">
          I lead visual design across brand, digital, web, events, campaigns
          and product marketing for Commerce and its portfolio of brands —
          including the move from BigCommerce to the broader Commerce
          organization.
        </p>
        <p class="now__link">
          <a class="link-chevron" href="/about">More about me</a>
        </p>
      </div>
      <div class="now__media" data-reveal style="--reveal-delay: 80ms">
        <Placeholder label="Workspace or portrait image" ratio="4 / 3" tone="light" />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--surface cta">
    <div class="container">
      <p class="cta__badge" data-reveal>
        <span class="pill__dot" aria-hidden="true"></span>
        <span class="eyebrow--caps">Available for freelance</span>
      </p>
      <h2 class="headline cta__title" data-reveal style="--reveal-delay: 60ms">
        Got something to make? I'm always happy to talk shop.
      </h2>
      <div class="cta__actions" data-reveal style="--reveal-delay: 120ms">
        <a class="button button--primary" href="/contact">Get in touch</a>
        <a class="button button--secondary" href={site.linkedin} rel="me noopener" target="_blank">
          Connect on LinkedIn
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: clamp(3rem, 7vw, 5.5rem);
  }

  .hero__headline {
    margin-top: 1.5rem;
    max-width: 14ch;
  }

  .hero__row {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero__sub {
    max-width: 34ch;
    font-size: var(--text-small);
    letter-spacing: 0;
  }

  .hero__worked {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .wordmarks {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  /* font-size is the scale the logo heights (in em) are measured against. */
  .wordmarks__item {
    display: grid;
    place-items: center;
    min-height: 5.5rem;
    padding: 1rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    font-size: clamp(0.8125rem, 0.7rem + 0.35vw, 1rem);
    color: var(--color-muted);
    transition: color 0.2s var(--ease);
  }

  .wordmarks__item:hover {
    color: var(--color-ink);
  }

  .wordmarks__item :global(svg) {
    display: block;
    width: auto;
    max-width: 100%;
  }

  /* Odd one out on the two-column phone grid spans the full row. */
  .wordmarks__item:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .hero__media {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .section-head {
    max-width: 44rem;
    margin-bottom: clamp(1.5rem, 3vw, 2rem);
  }

  .section-head__sub {
    margin-top: 0.75rem;
    max-width: 52ch;
  }

  .featured-lead {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--color-line);
  }

  .featured-more {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .featured-more__button {
    width: 100%;
    min-height: 3.5rem;
    background: var(--color-surface);
    border-color: transparent;
  }

  .featured-more__button:hover {
    background: var(--color-surface-2);
  }

  .stats__label {
    margin-bottom: 1rem;
  }

  .principle__markers {
    margin-bottom: 1rem;
  }

  .principle__body {
    margin-top: 0.5rem;
  }

  .approach-media {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .now {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .now__title {
    margin-top: 1rem;
  }

  .now__body {
    margin-top: 1rem;
    max-width: 46ch;
  }

  .now__link {
    margin-top: 1.5rem;
  }

  .cta__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-bg);
  }

  .cta__title {
    margin-top: 1.5rem;
    max-width: 20ch;
  }

  .cta__actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (min-width: 720px) {
    .hero__row {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .wordmarks {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .wordmarks__item:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }

  @media (min-width: 900px) {
    .now {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
