---
import Layout from '../layouts/Layout.astro';
import { site, experience, tools, capabilities } from '../data/site';
---

<Layout title="About" description={`About ${site.name}, ${site.role.toLowerCase()}.`}>
  <header class="about-head">
    <div class="intro">
      <p class="eyebrow">About</p>
      <h1>Visual designer with a systems brain.</h1>
      <p class="lead">
        <!-- PLACEHOLDER bio — rewrite in your own voice. -->
        I'm {site.name}, a {site.role.toLowerCase()} with a decade of experience across brand,
        product and design systems. I care about the details most people only notice when
        they're missing — spacing, rhythm, the weight of a headline — and about building them
        into systems so they survive contact with a growing team.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={`mailto:${site.email}`}>Get in touch</a>
        <a class="btn btn-ghost" href={site.resume}>Download CV</a>
      </div>
    </div>
    <div class="portrait" role="img" aria-label="Portrait placeholder">
      <span>{site.initials}</span>
    </div>
  </header>

  <section class="section two-col">
    <h2>Experience</h2>
    <ol class="timeline">
      {
        experience.map((e) => (
          <li>
            <span class="period">{e.period}</span>
            <div>
              <h3>{e.role}</h3>
              <p class="org">{e.org}</p>
              <p class="muted">{e.note}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section two-col">
    <h2>Capabilities</h2>
    <ul class="list">
      {
        capabilities.map((c) => (
          <li>
            <h3>{c.title}</h3>
            <p class="muted">{c.items.join(' · ')}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section two-col">
    <h2>Toolkit</h2>
    <ul class="tools">
      {tools.map((t) => <li class="chip">{t}</li>)}
    </ul>
  </section>
</Layout>

<style>
  .about-head {
    display: grid;
    gap: var(--space-7);
    padding-block: clamp(var(--space-7), 6vw, var(--space-8));
  }

  @media (min-width: 900px) {
    .about-head {
      grid-template-columns: minmax(0, 1fr) 18rem;
      align-items: end;
    }
  }

  .about-head h1 {
    margin-block: var(--space-3) var(--space-5);
    max-width: 16ch;
    font-size: var(--text-display);
    line-height: 1.02;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .portrait {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    max-width: 18rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--color-primary-soft), var(--color-primary));
    color: var(--color-on-primary);
    font-size: 3rem;
    font-weight: 600;
    letter-spacing: var(--tracking-display);
  }

  .two-col {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 900px) {
    .two-col {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-7);
    }

    .two-col h2 {
      font-size: var(--text-lg);
    }
  }

  .timeline,
  .list,
  .tools {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .timeline li:first-child {
    padding-top: 0;
  }

  .period {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
  }

  .org {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-primary-ink);
    margin-block: var(--space-1) var(--space-2);
  }

  .list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-5);
  }

  .list h3 {
    margin-bottom: var(--space-1);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
