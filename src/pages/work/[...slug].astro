---
import Layout from '../../layouts/Layout.astro';
import Cover from '../../components/Cover.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );
  return work.map((project, i) => ({
    params: { slug: project.id },
    props: { project, index: i, next: work[(i + 1) % work.length] },
  }));
}

const { project, index, next } = Astro.props;
const { Content, headings } = await render(project);
const d = project.data;
const toc = headings.filter((h) => h.depth === 2);

const facts = [
  { label: 'Client', value: d.client },
  { label: 'Year', value: String(d.year) },
  { label: 'Role', value: d.role },
  { label: 'Team', value: d.team },
  { label: 'Duration', value: d.duration },
].filter((f) => f.value);
---

<Layout title={`${d.client} — ${d.title}`} description={d.summary}>
  <article>
    <header class="cs-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/work">Work</a>
        <span aria-hidden="true">/</span>
        <span>{d.client}</span>
      </nav>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
      <ul class="chips" aria-label="Disciplines">
        <li class="chip chip-primary">{d.category}</li>
        {d.disciplines.map((x) => <li class="chip">{x}</li>)}
      </ul>
    </header>

    <div class="cs-cover">
      <Cover title={d.title} src={d.cover} tint={d.tint} variant={index} eager />
    </div>

    {
      d.outcomes.length > 0 && (
        <dl class="outcomes">
          {d.outcomes.map((o) => (
            <div>
              <dd>{o.value}</dd>
              <dt>{o.label}</dt>
            </div>
          ))}
        </dl>
      )
    }

    <div class="cs-body">
      <aside class="rail">
        <dl class="facts">
          {
            facts.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
        {
          toc.length > 0 && (
            <nav class="toc" aria-label="On this page">
              <p>On this page</p>
              <ul>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  {
    next && next.id !== project.id && (
      <a class="next" href={`/work/${next.id}`}>
        <span class="eyebrow">Next project</span>
        <span class="next-title">{next.data.client}</span>
        <span class="muted">{next.data.title}</span>
      </a>
    )
  }
</Layout>

<style>
  .cs-head {
    padding-block: clamp(var(--space-7), 6vw, var(--space-8)) var(--space-6);
  }

  .crumbs {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .crumbs a {
    color: var(--color-text-muted);
  }

  .crumbs a:hover {
    color: var(--color-text);
  }

  h1 {
    margin-block: var(--space-4);
    max-width: 20ch;
    font-size: var(--text-display);
    line-height: 1.02;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .chip-primary {
    background: var(--color-primary-soft);
    color: var(--color-primary-ink);
  }

  .cs-cover :global(.cover) {
    aspect-ratio: 16 / 8;
  }

  .outcomes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-3);
    margin: var(--space-3) 0 0;
  }

  .outcomes div {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .outcomes dd {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .outcomes dt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .cs-body {
    display: grid;
    gap: var(--space-7);
    padding-top: var(--space-8);
  }

  @media (min-width: 1100px) {
    .cs-body {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--space-8);
    }

    .rail {
      position: sticky;
      top: var(--space-6);
      align-self: start;
    }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-4);
    margin: 0;
  }

  @media (min-width: 1100px) {
    .facts {
      grid-template-columns: 1fr;
    }
  }

  .facts dt,
  .toc p {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-subtle);
    letter-spacing: var(--tracking-label);
  }

  .facts dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .toc {
    display: none;
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 1100px) {
    .toc {
      display: block;
    }
  }

  .toc ul {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .toc a {
    display: block;
    padding: var(--space-1) 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .toc a:hover {
    color: var(--color-text);
  }

  .next {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-8);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    transition: background-color 0.2s var(--ease);
  }

  .next:hover {
    background: var(--color-primary-soft);
  }

  .next-title {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }
</style>
