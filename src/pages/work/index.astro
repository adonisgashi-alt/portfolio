---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/site';

const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

/* Group by year, newest first, keeping the curated order within a year. */
const byYear = new Map<string, typeof projects>();
for (const p of projects) {
  const list = byYear.get(p.data.year) ?? [];
  list.push(p);
  byYear.set(p.data.year, list);
}
const groups = [...byYear.entries()].sort((a, b) => Number(b[0]) - Number(a[0]));

const disciplines = [...new Set(projects.flatMap((p) => p.data.disciplines))].sort();
const years = projects.map((p) => Number(p.data.year)).filter(Number.isFinite);
const countFor = (d: string) => projects.filter((p) => p.data.disciplines.includes(d)).length;
const span = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '';
---

<Layout
  title={`Work — ${site.name}`}
  description="Selected brand, product, campaign and editorial design work."
>
  <section class="section section--flush-bottom">
    <div class="container container--wide">
      <Breadcrumbs items={[{ label: 'Work' }]} />
      <div class="work-head">
        <h1 class="display work-title" data-reveal style="--reveal-delay: 60ms">
          Everything, in&nbsp;order.
        </h1>

        <div class="work-intro" data-reveal style="--reveal-delay: 120ms">
          <dl class="work-meta">
            <div class="work-meta__row">
              <dt>Projects</dt>
              <dd>{projects.length}</dd>
            </div>
            <div class="work-meta__row">
              <dt>Disciplines</dt>
              <dd>{disciplines.length}</dd>
            </div>
            <div class="work-meta__row">
              <dt>Years</dt>
              <dd>{span || '—'}</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--wide">
      <div class="work-filter" data-reveal>
        <p class="eyebrow--caps" id="work-filter-label">Project types</p>
        <ul class="work-filter__list" aria-labelledby="work-filter-label">
          <li>
            <button class="work-filter__button" type="button" data-filter="all" aria-pressed="true">
              All <span class="work-filter__count">{projects.length}</span>
            </button>
          </li>
          {
            disciplines.map((d) => (
              <li>
                <button class="work-filter__button" type="button" data-filter={d} aria-pressed="false">
                  {d} <span class="work-filter__count">{countFor(d)}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>

      {
        groups.map(([year, entries]) => (
          <section class="work-year" data-year-group aria-labelledby={`year-${year}`}>
            <header class="work-year__head" data-reveal>
              <h2 class="title work-year__title" id={`year-${year}`}>{year}</h2>
              <p class="caption work-year__count" data-year-count>
                {entries.length} {entries.length === 1 ? 'project' : 'projects'}
              </p>
            </header>
            <div class="grid grid--2 work-grid" style="--grid-gap: var(--space-layout-lg)">
              {entries.map((entry, i) => (
                <div
                  class="work-grid__item"
                  data-reveal
                  data-disciplines={entry.data.disciplines.join('|')}
                  style={`--reveal-delay: ${(i % 2) * 80}ms`}
                >
                  <WorkCard entry={entry} />
                </div>
              ))}
            </div>
          </section>
        ))
      }
      <p class="subhead work-empty" data-work-empty hidden>Nothing here yet.</p>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container container--wide">
      <p class="eyebrow--caps" data-reveal>Disciplines</p>
      <ul class="discipline-list" data-reveal style="--reveal-delay: 60ms">
        {disciplines.map((d) => <li class="title discipline-list__item">{d}</li>)}
      </ul>
      <p class="discipline-cta" data-reveal>
        <a class="link-chevron" href="/contact">Ask about anything here</a>
      </p>
    </div>
  </section>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.work-filter__button');
  const groups = document.querySelectorAll<HTMLElement>('[data-year-group]');
  const empty = document.querySelector<HTMLElement>('[data-work-empty]');

  function applyFilter(filter: string) {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    let total = 0;
    groups.forEach((group) => {
      let shown = 0;
      group.querySelectorAll<HTMLElement>('.work-grid__item').forEach((item) => {
        const match = filter === 'all' || (item.dataset.disciplines ?? '').split('|').includes(filter);
        item.hidden = !match;
        if (match) shown++;
      });
      group.hidden = shown === 0;
      const count = group.querySelector('[data-year-count]');
      if (count) count.textContent = `${shown} ${shown === 1 ? 'project' : 'projects'}`;
      total += shown;
    });
    if (empty) empty.hidden = total > 0;
  }

  buttons.forEach((b) => b.addEventListener('click', () => applyFilter(b.dataset.filter ?? 'all')));
</script>

<style>
  .work-head {
    display: grid;
    gap: var(--space-300);
    margin-top: var(--space-300);
  }

  .work-title {
    max-width: 14ch;
  }

  .work-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
  }

  .work-meta__row {
    display: grid;
    align-content: start;
    gap: var(--space-050);
    padding: 0 var(--space-200) 0 0;
  }

  .work-meta__row + .work-meta__row {
    padding-left: var(--space-200);
    border-left: 1px solid var(--color-line);
  }

  .work-meta dt {
    color: var(--color-muted);
    font-size: var(--text-small);
  }

  .work-meta dd {
    margin: 0;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (min-width: 720px) {
    .work-head {
      grid-template-columns: 1.1fr 1fr;
      align-items: end;
    }
  }

  .work-filter__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-100);
    margin: var(--space-200) 0 0;
    padding: 0;
    list-style: none;
  }

  .work-filter__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-100);
    min-height: var(--size-tap-target);
    padding: 0 var(--space-200);
    border: 1px solid var(--color-line);
    background: var(--color-bg);
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-small);
    cursor: pointer;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }

  .work-filter__button:hover {
    border-color: var(--color-ink);
  }

  .work-filter__button[aria-pressed='true'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-bg);
  }

  .work-filter__count {
    color: var(--color-muted);
    font-size: var(--text-fine);
  }

  .work-filter__button[aria-pressed='true'] .work-filter__count {
    color: inherit;
    opacity: 0.7;
  }

  .work-year {
    margin-top: var(--space-layout-xl);
  }

  .work-year__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-200);
    padding-top: var(--space-300);
    margin-bottom: var(--space-layout-md);
    border-top: 1px solid var(--color-line);
  }

  .work-year__count {
    color: var(--color-muted);
  }

  .work-empty {
    margin-top: var(--space-layout-xl);
    color: var(--color-muted);
  }

  .discipline-list {
    list-style: none;
    margin: var(--space-300) 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .discipline-list__item {
    padding: var(--space-200) 0;
    border-bottom: 1px solid var(--color-line);
    font-weight: 400;
    color: var(--color-ink);
  }

  .discipline-cta {
    margin-top: var(--space-400);
  }

  @media (min-width: 640px) {
    .discipline-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-layout-lg);
    }
  }
</style>
