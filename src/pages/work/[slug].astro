---
import Layout from '../../layouts/Layout.astro';
import Placeholder from '../../components/Placeholder.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { site } from '../../data/site';

export const getStaticPaths = (async () => {
  const projects = (await getCollection('work', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );

  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      // Wrap around, so the last project leads back to the first.
      next: projects[(i + 1) % projects.length],
    },
  }));
}) satisfies GetStaticPaths;

const { entry, next } = Astro.props;
const { title, client, year, role, summary, disciplines, cover, scope, sections, quote, gallery } =
  entry.data;
const { Content } = await render(entry);
---

<Layout title={`${title} — ${site.name}`} description={summary}>
  <article>
    <!-- Hero -->
    <header class="section section--flush-bottom">
      <div class="container">
        <p class="eyebrow--caps" data-reveal>{client} {year}</p>
        <h1 class="display project-title" data-reveal style="--reveal-delay: 60ms">{title}</h1>
        <p class="subhead measure--wide project-summary" data-reveal style="--reveal-delay: 120ms">
          {summary}
        </p>
      </div>

      <div class="container container--full project-cover" data-reveal style="--reveal-delay: 180ms">
        <Placeholder label={cover.label} ratio={cover.ratio} tone={cover.tone} />
      </div>
    </header>

    <!-- Credits -->
    <section class="section section--tight">
      <div class="container container--wide">
        <dl class="meta-grid project-meta" data-reveal>
          <div>
            <dt>Client</dt>
            <dd>{client}</dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd>{role}</dd>
          </div>
          <div>
            <dt>Year</dt>
            <dd>{year}</dd>
          </div>
          <div>
            <dt>Disciplines</dt>
            <dd>{disciplines.join(', ')}</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Overview -->
    <section class="section section--flush-top">
      <div class="container container--text">
        <div class="prose body-lg project-overview" data-reveal>
          <Content />
        </div>
      </div>
    </section>

    <!-- Numbers -->
    {
      scope.length > 0 && (
        <section class="section section--dark section--tight">
          <div class="container container--wide">
            <p class="eyebrow--caps scope__heading" data-reveal>Scope</p>
            <ul class="scope">
              {scope.map((item, i) => (
                <li class="scope__item" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
                  <span class="scope__value">{item.value}</span>
                  <span class="scope__label">{item.label}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- Narrative sections -->
    {
      sections.map((section) => (
        <section class:list={['section', 'project-section', `project-section--${section.layout}`]}>
          <div class="container container--wide">
            <div class="project-section__inner">
              <div class="project-section__copy" data-reveal>
                {section.eyebrow && <p class="eyebrow--caps">{section.eyebrow}</p>}
                <h2 class="headline project-section__title">{section.title}</h2>
                <p class="body-lg muted project-section__body">{section.body}</p>
              </div>

              {section.image && (
                <div class="project-section__media" data-reveal style="--reveal-delay: 80ms">
                  <Placeholder
                    label={section.image.label}
                    ratio={section.image.ratio}
                    tone={section.image.tone}
                    caption={section.image.caption}
                  />
                </div>
              )}
            </div>
          </div>
        </section>
      ))
    }

    <!-- Quote -->
    {
      quote && (
        <section class="section section--surface center">
          <div class="container">
            <blockquote class="project-quote" data-reveal>
              <p class="headline project-quote__text">&ldquo;{quote.text}&rdquo;</p>
              <footer class="caption project-quote__by">{quote.attribution}</footer>
            </blockquote>
          </div>
        </section>
      )
    }

    <!-- Gallery -->
    {
      gallery.length > 0 && (
        <section class="section">
          <div class="container container--wide">
            <p class="eyebrow--caps gallery__label" data-reveal>Gallery</p>
            <div class="grid grid--3" style="--grid-gap: var(--space-layout-xs)">
              {gallery.map((item, i) => (
                <div data-reveal style={`--reveal-delay: ${(i % 3) * 80}ms`}>
                  <Placeholder
                    label={item.label}
                    ratio={item.ratio}
                    tone={item.tone}
                    caption={item.caption}
                    radius="md"
                  />
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Next -->
    <section class="section section--surface">
      <div class="container container--wide next">
        <div class="next__copy" data-reveal>
          <p class="eyebrow--caps">Next project</p>
          <h2 class="headline next__title">
            <a href={`/work/${next.id}`}>{next.data.title}</a>
          </h2>
          <p class="subhead next__summary">{next.data.summary}</p>
          <p class="next__links link-row">
            <a class="link-chevron" href={`/work/${next.id}`}>View case study</a>
            <a class="link-chevron" href="/work">All work</a>
          </p>
        </div>
        <div class="next__media" data-reveal style="--reveal-delay: 80ms">
          <Placeholder label={next.data.cover.label} ratio="4 / 3" tone={next.data.cover.tone} />
        </div>
      </div>
    </section>
  </article>
</Layout>

<style>
  .project-title {
    margin-top: var(--space-200);
  }

  .project-summary {
    margin-top: var(--space-250);
  }

  .project-cover {
    margin-top: var(--space-layout-lg);
  }

  .project-meta {
    padding-bottom: var(--space-400);
    border-bottom: 1px solid var(--color-line);
  }

  .project-overview {
    padding-top: var(--space-layout-md);
  }

  .project-section__inner {
    display: grid;
    gap: var(--space-layout-md);
    align-items: center;
  }

  .project-section__title {
    margin-top: var(--space-200);
  }

  .project-section__body {
    margin-top: var(--space-250);
    max-width: 44ch;
  }

  .project-section--full .project-section__media {
    margin-top: var(--space-layout-md);
  }

  .project-section--full .project-section__body {
    max-width: 58ch;
  }

  .scope__heading {
    margin-bottom: var(--space-300);
  }

  .scope {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-400);
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
  }

  .scope__value {
    display: block;
    font-size: var(--text-title);
    line-height: 1.15;
    letter-spacing: var(--tracking-title);
    font-weight: 500;
  }

  .scope__label {
    display: block;
    margin-top: var(--space-100);
    font-size: var(--text-body);
    color: var(--color-muted);
  }

  .project-quote {
    margin: 0;
  }

  .project-quote__text {
    max-width: 22ch;
    margin-inline: auto;
    text-wrap: balance;
  }

  .project-quote__by {
    margin-top: var(--space-300);
  }

  .gallery__label {
    margin-bottom: var(--space-300);
  }

  .next {
    display: grid;
    gap: var(--space-layout-md);
    align-items: center;
  }

  .next__title {
    margin-top: var(--space-200);
  }

  .next__title a {
    text-decoration: none;
  }

  .next__title a:hover {
    opacity: 0.65;
  }

  .next__summary {
    margin-top: var(--space-200);
    max-width: 40ch;
  }

  .next__links {
    margin-top: var(--space-300);
  }

  @media (min-width: 900px) {
    .project-section--split .project-section__inner,
    .project-section--split-reverse .project-section__inner {
      grid-template-columns: 1fr 1fr;
    }

    .project-section--split-reverse .project-section__copy {
      order: 2;
    }

    .next {
      grid-template-columns: 1fr 0.9fr;
    }
  }
</style>
