---
import '@fontsource-variable/inter/opsz.css';
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import CtaPanel from '../components/CtaPanel.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Hide the closing "let's work together" panel (e.g. on 404). */
  hideCta?: boolean;
}

const { title, description = site.description, hideCta = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0e12" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <Sidebar />
      <div class="main-col">
        <main id="main">
          <slot />
        </main>
        {!hideCta && <CtaPanel />}
        <footer class="site-footer">
          <p>&copy; {new Date().getFullYear()} {site.name}</p>
          <p class="footer-links">
            {
              site.socials.map((s) => (
                <a href={s.href} rel="me noopener" target="_blank">
                  {s.label}
                </a>
              ))
            }
          </p>
        </footer>
      </div>
    </div>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -3rem;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-text);
    color: var(--color-bg);
    font-size: var(--text-sm);
  }

  .skip-link:focus {
    top: var(--space-4);
  }

  .shell {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 100dvh;
  }

  @media (min-width: 960px) {
    .shell {
      grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    }
  }

  .main-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-inline: var(--gutter);
  }

  main {
    flex: 1;
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    padding-block: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-links a:hover {
    color: var(--color-text);
  }
</style>
